<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    tools:context=".ui.forgot.ForgotPasswordActivity">

    <ScrollView
        android:id="@+id/scrollViewForgot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <RelativeLayout
                android:id="@+id/containerBackgroundForgot"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:background="@color/purple"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/imageBackgroundForgot"
                    android:layout_width="238dp"
                    android:layout_height="266dp"
                    android:src="@drawable/background_2"
                    android:importantForAccessibility="no"
                    android:layout_centerInParent="true" />

                <ImageView
                    android:id="@+id/imageIntroForgot"
                    android:layout_width="160dp"
                    android:layout_height="80dp"
                    android:src="@drawable/intro"
                    android:contentDescription="@string/forgot_password_logo_description"
                    android:layout_centerInParent="true" />
            </RelativeLayout>

            <ImageButton
                android:id="@+id/buttonGoBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_left"
                android:background="@null"
                android:contentDescription="@string/forgot_password_back_description"
                android:layout_marginTop="16dp"
                android:layout_marginStart="20dp"
                app:layout_constraintTop_toBottomOf="@id/containerBackgroundForgot"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/textViewTitleForgot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_password_title"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="24sp"
                android:textColor="@color/text_title"
                android:layout_marginTop="24dp"
                android:layout_marginStart="32dp"
                app:layout_constraintTop_toBottomOf="@id/buttonGoBack"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/textViewSubtitleForgot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_password_subtitle"
                android:fontFamily="@font/poppins"
                android:textSize="14sp"
                android:textColor="@color/text_base"
                android:layout_marginTop="16dp"
                android:layout_marginStart="32dp"
                app:layout_constraintTop_toBottomOf="@id/textViewTitleForgot"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                style="@style/CustomFilledTextFieldEmail"
                android:hint="@string/forgot_password_email_label"
                app:errorEnabled="true"
                app:layout_constraintTop_toBottomOf="@id/textViewSubtitleForgot"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textInputEditEmail"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:textColor="@color/text_base"
                    android:textAppearance="@font/poppins"
                    android:textSize="16sp"
                    android:inputType="textEmailAddress"
                    android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/buttonSend"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:text="@string/forgot_password_button_disabled"
                android:textAllCaps="false"
                android:backgroundTint="@color/shape_disable"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_complement"
                android:textSize="16sp"
                android:elevation="0dp"
                android:enabled="false"
                android:stateListAnimator="@null"
                app:layout_constraintTop_toBottomOf="@id/textInputLayoutEmail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
